&НаКлиенте
Процедура Подключаемый_ТЮР_ПересчитатьПоСкидке(Команда)
    // Начало. ТЮР. Пересчет по команде пользователя.
    ТЮР_ПересчитатьСтрокиПоСкидке();
    // Конец. ТЮР. Пересчет по команде пользователя.
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обрабатывает ответ на предложение пересчета.
//
// Параметры:
//  РезультатВопроса - КодВозвратаДиалога - ответ пользователя.
//  ДополнительныеПараметры - Произвольный - параметры оповещения.
//
&НаКлиенте
Процедура ТЮР_ПослеВопросаОПересчетеСкидки(
    РезультатВопроса, ДополнительныеПараметры) Экспорт
    // Начало. ТЮР. Обработка ответа пользователя.
    Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
        ТЮР_ПересчитатьСтрокиПоСкидке();
    КонецЕсли;
    // Конец. ТЮР. Обработка ответа пользователя.
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
    // Начало. ТЮР. Учет согласованной скидки.
    Если ТекущиеДанные = Неопределено Тогда
        Возврат;
    КонецЕсли;

    КоэффициентСкидки = 1 - ТекущиеДанные.Скидка / 100;

    // Исходный расчет поставщика:
    // ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * КоэффициентСкидки;

    КоэффициентСогласованнойСкидки =
        1 - Объект.ТЮР_СогласованнаяСкидка / 100;
    ТекущиеДанные.Сумма = Окр(
        ТекущиеДанные.Цена
        * ТекущиеДанные.Количество
        * КоэффициентСкидки
        * КоэффициентСогласованнойСкидки,
        2);

    РассчитатьСуммуДокумента();
    // Конец. ТЮР. Учет согласованной скидки.
КонецПроцедуры

&НаКлиенте
Процедура ТЮР_ПересчитатьСтрокиПоСкидке()
    // Начало. ТЮР. Пересчет товаров и услуг.
    ТабличныеЧасти = Новый Массив;
    ТабличныеЧасти.Добавить(Объект.Товары);
    ТабличныеЧасти.Добавить(Объект.Услуги);

    Для Каждого ТабличнаяЧасть Из ТабличныеЧасти Цикл
        Для Каждого СтрокаТаблицы Из ТабличнаяЧасть Цикл
            РассчитатьСуммуСтроки(СтрокаТаблицы);
        КонецЦикла;
    КонецЦикла;

    РассчитатьСуммуДокумента();
    Модифицированность = Истина;
    // Конец. ТЮР. Пересчет товаров и услуг.
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

