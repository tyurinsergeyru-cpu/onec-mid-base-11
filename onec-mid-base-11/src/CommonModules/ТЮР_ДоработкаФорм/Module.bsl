#Область ПрограммныйИнтерфейс

// Добавляет поле контактного лица в форму документа.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - дорабатываемая форма.
//
Процедура ДобавитьПолеКонтактноеЛицо(Форма) Экспорт
    // Начало. ТЮР. Добавление контактного лица.
    Если Форма.Элементы.Найти("ТЮР_КонтактноеЛицо") <> Неопределено Тогда
        Возврат;
    КонецЕсли;

    ЭлементОриентир = Форма.Элементы.Найти("Договор");
    Если ЭлементОриентир = Неопределено Тогда
        ЭлементОриентир = Форма.Элементы.Найти("Контрагент");
    КонецЕсли;

    Если ЭлементОриентир = Неопределено Тогда
        Возврат;
    КонецЕсли;

    Родитель = ЭлементОриентир.Родитель;
    СледующийЭлемент = Неопределено;
    ИндексОриентира = Родитель.ПодчиненныеЭлементы.Индекс(ЭлементОриентир);

    Если Родитель.ПодчиненныеЭлементы.Количество() > ИндексОриентира + 1 Тогда
        СледующийЭлемент = Родитель.ПодчиненныеЭлементы.Получить(
            ИндексОриентира + 1);
    КонецЕсли;

    НовоеПоле = Форма.Элементы.Вставить(
        "ТЮР_КонтактноеЛицо", Тип("ПолеФормы"), Родитель, СледующийЭлемент);

    НовоеПоле.Вид = ВидПоляФормы.ПолеВвода;
    НовоеПоле.ПутьКДанным = "Объект.ТЮР_КонтактноеЛицо";
    НовоеПоле.Заголовок = "Контактное лицо";
    // Конец. ТЮР. Добавление контактного лица.
КонецПроцедуры

// Добавляет поле согласованной скидки и кнопку пересчета в форму заказа.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - дорабатываемая форма.
//
Процедура ДобавитьПолеСогласованнаяСкидка(Форма) Экспорт
    // Начало. ТЮР. Добавление согласованной скидки.
    Если Форма.Элементы.Найти("ТЮР_СогласованнаяСкидка") <> Неопределено Тогда
        Возврат;
    КонецЕсли;

    ЭлементОрганизация = Форма.Элементы.Найти("Организация");
    Если ЭлементОрганизация = Неопределено Тогда
        Возврат;
    КонецЕсли;

    ПолеСкидки = Форма.Элементы.Добавить(
        "ТЮР_СогласованнаяСкидка",
        Тип("ПолеФормы"),
        ЭлементОрганизация.Родитель);

    ПолеСкидки.Вид = ВидПоляФормы.ПолеВвода;
    ПолеСкидки.ПутьКДанным = "Объект.ТЮР_СогласованнаяСкидка";
    ПолеСкидки.Заголовок = "Согласованная скидка, %";
    ПолеСкидки.УстановитьДействие(
        "ПриИзменении",
        "Подключаемый_ТЮР_СогласованнаяСкидкаПриИзменении");

    КомандаПересчета = Форма.Команды.Добавить(
        "ТЮР_ПересчитатьПоСкидке");
    КомандаПересчета.Заголовок = "Пересчитать по скидке";
    КомандаПересчета.Действие =
        "Подключаемый_ТЮР_ПересчитатьПоСкидке";

    КнопкаПересчета = Форма.Элементы.Добавить(
        "ТЮР_ПересчитатьПоСкидке",
        Тип("КнопкаФормы"),
        ПолеСкидки.Родитель);

    КнопкаПересчета.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
    КнопкаПересчета.ИмяКоманды = "ТЮР_ПересчитатьПоСкидке";
    КнопкаПересчета.Заголовок = "Пересчитать по скидке";
    // Конец. ТЮР. Добавление согласованной скидки.
КонецПроцедуры

#КонецОбласти